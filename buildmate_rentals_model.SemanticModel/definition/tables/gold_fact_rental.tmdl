table gold_fact_rental
	lineageTag: 4a58f63d-a183-414c-a5f4-2d8ac312253b
	sourceLineageTag: [gold].[gold_fact_rental]

	measure Utilisation =
			
			DIVIDE(
			    SUM(gold_fact_rental[asset_days_in_window]),
			    SUMX(
			        gold_dim_depots,
			        gold_dim_depots[fleet_size] * 30
			    )
			) * 100
